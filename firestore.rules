rules_version = '2';

// HIKARI NEWS のセキュリティルール
// - 記事（items / meta）は「承認済みユーザー」と管理者だけが読める
// - 書き込みはボット（サーバー側の Admin SDK）だけ。ルールは Admin SDK には適用されない
// - ユーザーは自分の「閲覧申請」を pending で1回だけ作れる。承認・拒否は管理者だけ
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isApproved() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /items/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if false;
    }

    // 学習コンテンツ（キーワード図鑑・問題集・アイデア辞書・お題）：読むだけ
    match /learn/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if false;
    }

    // 「この問題おかしいかも」の報告：承認済みユーザーが作るだけ。読むのは管理者
    match /reports/{id} {
      allow create: if (isApproved() || isAdmin())
        && request.resource.data.keys().hasOnly(['qid', 'topic', 'track', 'q', 'reason', 'uid', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 20
        && request.resource.data.track is string && request.resource.data.track.size() <= 20
        && request.resource.data.q is string && request.resource.data.q.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // 学習の進み具合（自分のものだけ読み書き）
    match /users/{uid}/progress/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid && (isApproved() || isAdmin());
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'note', 'email', 'photoURL', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];

      allow delete: if isAdmin();
    }
  }
}
