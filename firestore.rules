rules_version = '2';

// HIKARI NEWS のセキュリティルール
// - 記事（items / meta）と学習コンテンツ（learn）は誰でも読める（ログイン不要）
//   ただし一覧の読み込みは件数に上限をつけて、まとめて大量に読まれないようにする
// - 書き込みはボット（サーバー側の Admin SDK）だけ。ルールは Admin SDK には適用されない
// - ログインした人は「問題の報告」と「自分の学習記録の同期」ができる
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /items/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow write: if false;
    }

    match /meta/{id} {
      allow get: if true;
      allow write: if false;
    }

    // 学習コンテンツ（キーワード図鑑・問題集・アイデア辞書・お題）：読むだけ
    match /learn/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow write: if false;
    }

    // 「この問題おかしいかも」の報告：ログインした人が作るだけ。読むのは管理者
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['qid', 'topic', 'track', 'q', 'reason', 'uid', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 40
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 20
        && request.resource.data.track is string && request.resource.data.track.size() <= 20
        && request.resource.data.q is string && request.resource.data.q.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // 「このサイトについて」のフォーム（掲載の取り下げ・訂正の依頼など）：誰でも送れる。読むのは管理者だけ
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'url', 'message', 'contact', 'status', 'createdAt'])
        && request.resource.data.kind in ['takedown', 'fix', 'other']
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // 受け取り設定（メール・自分の Discord）：本人だけが読み書きできる。メールは Google で確認済みの自分のアドレスだけ
    match /subscriptions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'email_on', 'email_mode', 'webhook', 'webhook_on', 'updated'])
        && request.resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true
        && request.resource.data.email_on is bool
        && request.resource.data.email_mode in ['each', 'daily']
        && request.resource.data.webhook_on is bool
        && request.resource.data.webhook is string
        && (request.resource.data.webhook == ''
            || (request.resource.data.webhook.size() <= 200
                && request.resource.data.webhook.matches('^https://((ptb|canary)[.])?discord(app)?[.]com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$')))
        && request.resource.data.updated == request.time;
    }

    // 学習の進み具合（自分のものだけ読み書き）
    match /users/{uid}/progress/{doc} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 以前の「閲覧申請」の記録：管理者だけが見る・消せる（新しい申請はもう作らない）
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }
  }
}
